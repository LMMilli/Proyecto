<?xml version="1.0" encoding="UTF-8" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/backgroundColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center_horizontal">

        <!-- Titulo de Bienvenida -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvBienvenida"
            android:text="¡Hola, Atleta!"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/textColorPrimary"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="48dp"/>

        <!-- Botones Principales -->
        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:id="@+id/btnMisEntrenamientos"
            android:text="MIS ENTRENAMIENTOS"
            android:textStyle="bold"
            android:textSize="16sp"
            app:cornerRadius="8dp"
            android:textColor="#FFFFFF"
            app:backgroundTint="@color/primaryColor"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:id="@+id/btnCatalogoRutinas"
            android:text="CATÁLOGO DE RUTINAS"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            android:textColor="#FFFFFF"
            app:backgroundTint="@color/primaryColor"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:id="@+id/btnMisMedidas"
            android:text="MIS MEDIDAS"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            android:textColor="#FFFFFF"
            app:backgroundTint="@color/primaryColor"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:id="@+id/btnMisObjetivos"
            android:text="MIS OBJETIVOS"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            android:textColor="#FFFFFF"
            app:backgroundTint="@color/primaryColor"
            android:layout_marginBottom="40dp"/>


        <!-- Boton de administrador oculto por defecto -->
        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:id="@+id/btnPanelAdmin"
            android:text="PANEL DE ADNIMISTRADOR"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9800"
            app:cornerRadius="8dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <!-- Boton de cerrar sesion estilo outlined -->
        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:id="@+id/btnLogout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:text="CERRAR SESION"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            app:strokeColor="#D32F2F"
            app:strokeWidth="2dp"
            app:cornerRadius="8dp"
            android:layout_marginBottom="24dp"/>
    </LinearLayout>
</ScrollView>
