<?xml version="1.0" encoding="UTF-8" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/backgroundColor">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nueva Meta"
        android:textColor="@color/textColorPrimary"
        android:textStyle="bold"
        android:textSize="28sp"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¿Qué quieres conseguir?"
        android:textColor="@color/textColorSecondary"
        android:layout_marginBottom="8dp"/>

    <Spinner
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@android:drawable/btn_dropdown"
        android:layout_marginBottom="24dp"
        android:id="@+id/spinnerTipoObjetivo"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Valor (ej: 75kg, 12%grasa, 100kg banca)"
        android:layout_marginBottom="24dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/etValorObjetivo"
            android:inputType="text"
            />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fecha limite"
        android:textColor="@color/textColorSecondary"
        android:layout_marginBottom="8dp"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:id="@+id/btnSeleccionarFecha"
        android:text="Seleccionar fecha"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:textColor="@color/primaryColor"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/tvFechaSeleccionada"
        android:text="No seleccionada"
        android:textAlignment="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"/>

    <com.google.android.material.button.MaterialButton
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:id="@+id/btnGuardarObjetivo"
        android:text="GUARDAR OBJETIVO"
        android:backgroundTint="@color/primaryColor"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:cornerRadius="8dp"/>
</LinearLayout>