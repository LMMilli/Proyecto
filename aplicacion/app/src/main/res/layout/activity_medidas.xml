<?xml version="1.0" encoding="UTF-8" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/backgroundColor">

    <!-- Título Principal -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mi Progreso"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/textColorPrimary"
        android:gravity="center_horizontal"
        android:layout_marginBottom="24dp"/>

    <!-- Tarjeta para elvolver la Gráfica -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/surfaceColor"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <com.github.mikephil.charting.charts.LineChart
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:id="@+id/graficaPeso"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Título del Historial -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Historial Detallado"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/textColorPrimary"
        android:layout_marginBottom="12dp"/>

    <!-- Indicador de carga oculto por defecto -->
    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/progressBarMedidas"
        android:layout_gravity="center"
        android:indeterminateTint="@color/primaryColor"
        android:visibility="gone"/>

    <!-- Mensaje de estado vacio oculto por defecto -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/tvEmptyState"
        android:text="Aún no hay medidas registradas"
        android:textAlignment="center"
        android:textColor="@color/textColorSecondary"
        android:textStyle="italic"
        android:visibility="gone"
        android:layout_marginTop="20dp"/>

    <!-- Lista de Historial -->
    <ListView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/lvHistorialMedidas"
        android:layout_weight="1"
        android:divider="@color/textColorSecondary"
        android:dividerHeight="1dp"
        android:layout_marginBottom="16dp"/>

    <!-- Boton de Nueva Medidad fiajdo abajo -->
    <com.google.android.material.button.MaterialButton
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:id="@+id/btnIrNuevaMedida"
        android:text="REGISTAR NUEVO PESO"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="@color/primaryColor"
        app:cornerRadius="8dp"/>

</LinearLayout>